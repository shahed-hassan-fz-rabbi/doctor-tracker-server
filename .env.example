NODE_ENV=development

# Server
PORT=4000
LOG_LEVEL=info

# MongoDB Atlas (replace with your own cluster connection string)
MONGODB_URI=mongodb://127.0.0.1:27017/doctor-tracker

# Auth
JWT_SECRET=replace-with-a-long-random-string-min-16-chars
JWT_EXPIRES_IN=7d
COOKIE_NAME=dt_token
# Set true in production (Render) so cookies are Secure
COOKIE_SECURE=false

# CORS — comma separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000

# Rate limiting
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=300
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15
LOGIN_RATE_LIMIT_MAX=10

# Admin seed script (only used by scripts/seedAdmin.js)
ADMIN_NAME=replace-with-admin-name
ADMIN_EMAIL=replace-with-admin@example.com
ADMIN_PASSWORD=replace-with-a-unique-password

# Separate public demo service only. Do not set production credentials here.
# Runtime database user: read-only on doctor-tracker-demo.
# Runtime MongoDB URI must target /doctor-tracker-demo.
# DEMO_MODE=true
# DEMO_MONGODB_URI=mongodb+srv://<read-only-user>:<encoded-password>@<cluster>/<doctor-tracker-demo>?retryWrites=true&w=majority
# DEMO_JWT_SECRET=<unique-random-secret-at-least-32-characters>
# COOKIE_NAME=dt_demo_token
# COOKIE_SECURE=true

# One-time provisioning only; never configure these on the Render runtime service.
# Use a temporary Atlas user scoped to readWrite on doctor-tracker-demo, then revoke it.
# DEMO_SEED_MONGODB_URI=
# DEMO_ACCOUNT_EMAIL=demo@doctortracker.com
# DEMO_ACCOUNT_PASSWORD=
