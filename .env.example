DATABASE=./.env
DATABASE=./.env.local
NODE_ENV=development

# Server
PORT=4000
LOG_LEVEL=info

# MongoDB Atlas (replace with your own cluster connection string)
MONGODB_URI=mongodb://127.0.0.1:27017/doctor-tracker

# Auth
JWT_SECRET=replace-with-a-long-random-string-min-16-chars
JWT_EXPIRES_IN=7d
COOKIE_NAME=dt_token
# Set true in production (Render) so cookies are Secure
COOKIE_SECURE=false

# CORS — comma separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000

# Rate limiting
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=300
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15
LOGIN_RATE_LIMIT_MAX=10

# Admin seed script (only used by scripts/seedAdmin.js)
ADMIN_NAME=System Admin
ADMIN_EMAIL=admin@doctracker.local
ADMIN_PASSWORD=ChangeMe123!
